# Copy this file to .env and fill in your local values.

# Option 1: full SQLAlchemy URL (takes precedence over the settings below)
# DATABASE_URL=mysql+pymysql://portfolio_user:your_password@127.0.0.1:3306/investment_portfolio

# Option 2: individual connection settings
DB_DIALECT=mysql
DB_DRIVER=pymysql
DB_USER=portfolio_user
DB_PASSWORD=your_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=investment_portfolio

# Optional: date range for the price ETL (defaults: 2015-01-01 → today)
# PRICE_START_DATE=2015-01-01
# PRICE_END_DATE=2025-01-01

# Optional: SQLAlchemy tuning
# SQLALCHEMY_ECHO=0
# SQLALCHEMY_POOL_SIZE=5
# SQLALCHEMY_MAX_OVERFLOW=10
